{
  "name": "paseo-mail",
  "private": true,
  "version": "0.2.1",
  "description": "Paseo plugin: agent-to-agent mail for Paseo: durable mailboxes, with a short nudge when the recipient is idle.",
  "license": "MIT",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
